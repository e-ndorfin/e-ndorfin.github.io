---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import profileImage from '../assets/profile.jpg';

const homepageTitle = 'Zachary Tang';
const homepageDescription = 'Zachary Tang is a roboticist and University of Toronto undergraduate researching general physical intelligence, VLAs, multi-agent RL, and robotics.';
const homepageStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Zachary Tang',
	url: 'https://e-ndorfin.github.io/',
	sameAs: [
		'https://github.com/e-ndorfin',
		'https://x.com/zacharytangg',
	],
	affiliation: {
		'@type': 'CollegeOrUniversity',
		name: 'University of Toronto',
	},
	knowsAbout: [
		'Robotics',
		'Vision-Language-Action Models',
		'Multi-Agent Reinforcement Learning',
		'Physical Intelligence',
		'Data Science',
	],
};

const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);
---

<Layout title={homepageTitle} description={homepageDescription} structuredData={homepageStructuredData}>
	<div class="mt-8 space-y-10">
		<section class="flex flex-col-reverse sm:flex-row gap-8 items-start">
			<div class="flex-1">
				<p class="text-gray-600 leading-relaxed">
				I am a third-year undergraduate studying <a href="https://web.cs.toronto.edu" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-theme-accent">Computer Science</a> at the University of Toronto.

				I'm currently working with <a href="https://youngwoon.github.io/" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-theme-accent">Prof. Youngwoon Lee</a> from Seoul National University and <a href="https://cglee.mie.utoronto.ca/" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-theme-accent">Prof. Chi-Guhn Lee</a> from the University of Toronto on sample-efficient performance saturation of manipulation tasks, as well as <a href="https://drmatttaylor.net" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-theme-accent">Prof. Matthew Taylor</a> from the University of Alberta on multi-agent deep RL emergent communication.
				</p>
				<p class="text-gray-600 leading-relaxed mt-4">
				I'm currently interested in exploring how we can best help robots learn new tasks <strong>efficiently</strong> and <strong>robustly</strong>.
				</p>
				<p class="mt-6 mb-4"><a href="mailto:zach.tang@mail.utoronto.ca" class="text-theme-accent">zach.tang@mail.utoronto.ca</a></p>
                <div class="flex space-x-4 mt-6">
                    <a href="https://github.com/e-ndorfin" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub" class="no-underline text-gray-600 hover:text-theme-accent transition-colors">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.58 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.28 9.28 0 0 1 12 6.92a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"/></svg>
                    </a>
                    <a href="https://x.com/zacharytangg" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter" title="X / Twitter" class="no-underline text-gray-600 hover:text-theme-accent transition-colors">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.83-5.98 6.83H1.65l7.73-8.84L1.23 2.25h6.83l4.72 6.24 5.46-6.24Zm-1.16 17.52h1.84L7.37 4.13H5.4l11.68 15.64Z"/></svg>
                    </a>
                    <a href="https://www.linkedin.com/in/zachary-tang-463453333/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn" class="no-underline text-gray-600 hover:text-theme-accent transition-colors">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.2 3.5a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 0 0 0-4.4ZM3.35 9.6h3.7V21h-3.7V9.6Zm5.95 0H12.8v1.56h.05c.55-1.04 1.9-2.14 3.9-2.14 4.17 0 4.94 2.74 4.94 6.3V21h-3.7v-5.05c0-1.2-.02-2.75-1.68-2.75-1.68 0-1.94 1.31-1.94 2.66V21H9.3V9.6Z"/></svg>
                    </a>
                    <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" aria-label="CV" title="CV" class="no-underline text-gray-600 hover:text-theme-accent transition-colors">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M8.5 13h7M8.5 16h7"/></svg>
                    </a>
                </div>
			</div>
			<div class="shrink-0">
				<Image 
					src={profileImage} 
					alt="Zachary Tang" 
					class="w-56 h-56 rounded-lg object-cover border border-gray-200 shadow-lg"
					width={384}
					height={384}
				/>
			</div>
		</section>

		<section class="border-t border-theme-brown/30 pt-8">
			<h2 class="text-xl font-semibold text-theme-text mb-4">Recent Rabbitholes</h2>
			<ul class="space-y-4">
				{posts.map((post) => (
					<li class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between group">
						<a href={`/rabbitholes/${post.id}/`} class="text-theme-text hover:text-theme-accent transition-colors font-medium">
							{post.data.title}
						</a>
                        <span class="text-sm text-gray-500 font-mono mt-1 sm:mt-0 whitespace-nowrap sm:ml-4">
                            <FormattedDate date={post.data.pubDate} />
                        </span>
					</li>
				))}
			</ul>
            <div class="mt-4">
                <a href="/rabbitholes" class="text-sm text-gray-500 hover:text-theme-accent transition-colors">View all rabbitholes &rarr;</a>
			</div>
		</section>

		<section class="border-t border-theme-brown/30 pt-8">
			<h2 class="text-xl font-semibold text-theme-text mb-4">Publications</h2>
			<article class="flex flex-col sm:flex-row gap-6 items-start">
				<div>
					<h3 class="text-lg font-semibold text-theme-text leading-snug">
						<a href="https://arxiv.org/abs/2606.18097" target="_blank" rel="noopener noreferrer" class="text-theme-text hover:text-theme-accent no-underline transition-colors">
							WireCraft: A Simulation Benchmark for Industrial DLO Manipulation
						</a>
					</h3>
					<p class="text-gray-600 mt-2 leading-relaxed">
						Chongyu Zhu, Ramy ElMallah, Hyegang Kim, <span class="font-medium text-theme-text">Zachary Tang</span>, Jiachen Rao, Artem Arutyunov, Seungyeon Ha, and Chi-Guhn Lee
					</p>
					<div class="text-sm text-gray-600 mt-3 space-y-2">
						<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
							<span class="font-medium text-theme-text">CoRL 2026</span>
						</div>
						<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
							<span class="font-medium text-theme-text">DOM-R3 Workshop · IROS 2026</span>
							<span class="inline-flex items-center rounded-full bg-theme-accent px-2 py-0.5 text-xs font-bold uppercase tracking-wide text-white">Oral</span>
						</div>
					</div>
				</div>
				<a href="https://arxiv.org/abs/2606.18097" target="_blank" rel="noopener noreferrer" class="block w-full sm:w-64 shrink-0 no-underline">
					<img src="/images/wirecraft-preview.png" alt="Preview of the WireCraft publication page" class="w-full h-auto rounded border border-theme-brown/20 shadow-sm" />
				</a>
			</article>
		</section>

		<section class="prose prose-p:text-gray-600 max-w-none border-t border-theme-brown/30 pt-8">
			<h2 class="text-xl font-semibold text-theme-text mb-4 not-prose">Miscellaneous</h2>
			<p class="text-gray-600 leading-relaxed">
				Naturalized Australian born in Hong Kong! Spoke English at home and English/Mandarin at school though, so please don't test me on my Cantonese :)
			</p>
			<p class="text-gray-600 leading-relaxed mt-4">
				Outside of research, I love playing the drums, belting out English and Mandarin songs at karaoke with friends, and skiing whenever the weather permits.
			</p>
		</section>
	</div>
</Layout>
